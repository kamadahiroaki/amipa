# /opt/ggb/.env にコピーして使う（compose.yml が読む）。
# 必須
GGB_IMAGE=ghcr.io/<org>/ggb-viewer:v0.1
GGB_DOMAIN=ggb-demo.japaneast.cloudapp.azure.com
GGB_ACME_EMAIL=you@example.ac.jp

# データ（マネージドディスク上）。Blob/Files を指さないこと
GGB_DATA=/data/bundles

# 小さめの VM では下げる。64GiB クラスなら 512〜1024 でよい
GGB_CACHE_MB=512
GGB_DB_WORKERS=4

# 1 リクエストの上限（重い矩形で全体が詰まるのを防ぐ保険）
GGB_MAX_ROWS=400000
GGB_FETCH_MS=20000

# 起動時プリウォーム。**WG では空にする**（載りきらず帯域だけ食う）。chr22 等 RAM に載る DB のみ
GGB_PREWARM=
