# /opt/amipa/.env にコピーして使う（compose.yml が読む）。
# 必須
#   ★コンテナのタグは v なし（git のタグは v0.1.0、イメージは 0.1.0 / 0.1 / latest）
AMIPA_IMAGE=ghcr.io/kamadahiroaki/amipa-viewer:0.1
AMIPA_DOMAIN=<DNS名ラベル>.japaneast.cloudapp.azure.com
AMIPA_ACME_EMAIL=you@example.ac.jp

# データ（マネージドディスク上）。Blob/Files を指さないこと
AMIPA_DATA=/data/bundles

# 接続ごとの SQLite ページキャッシュ(MB)と DB 読み取りワーカー数。
# ★worker ごとに接続が増える＝キャッシュも掛け算になる。8GiB の VM で 512×(1+4) は破綻する。
#   目安: 8GiB → 128 / 2、16GiB → 256 / 2、64GiB → 512 / 4
AMIPA_CACHE_MB=128
AMIPA_DB_WORKERS=2

# 1 リクエストの上限（重い矩形で全体が詰まるのを防ぐ保険）
AMIPA_MAX_ROWS=400000
AMIPA_FETCH_MS=20000

# 起動時プリウォーム。★空文字では無効にならない（既定＝全部温める、になる）。
#   切るなら必ず off。WG は載りきらないので off、chr22 等 RAM に載る DB なら未設定でよい。
AMIPA_PREWARM=off
