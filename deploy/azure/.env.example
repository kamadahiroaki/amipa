# /opt/amipa/.env にコピーして使う（compose.yml が読む）。
# 必須
AMIPA_IMAGE=ghcr.io/kamadahiroaki/amipa-viewer:v0.1
AMIPA_DOMAIN=amipa-demo.japaneast.cloudapp.azure.com
AMIPA_ACME_EMAIL=you@example.ac.jp

# データ（マネージドディスク上）。Blob/Files を指さないこと
AMIPA_DATA=/data/bundles

# 小さめの VM では下げる。64GiB クラスなら 512〜1024 でよい
AMIPA_CACHE_MB=512
AMIPA_DB_WORKERS=4

# 1 リクエストの上限（重い矩形で全体が詰まるのを防ぐ保険）
AMIPA_MAX_ROWS=400000
AMIPA_FETCH_MS=20000

# 起動時プリウォーム。**WG では空にする**（載りきらず帯域だけ食う）。chr22 等 RAM に載る DB のみ
AMIPA_PREWARM=
